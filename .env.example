# Copiar a `.env` y rellenar. Nunca commitear secretos.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Denominacion del pool (wei). Default tipico de lab: 0.1 ether = 100000000000000000
DENOMINATION_WEI=100000000000000000

# Merkle tree depth (debe coincidir con el circuito Circom)
MERKLE_TREE_LEVELS=20
